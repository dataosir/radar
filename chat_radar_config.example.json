{
  "meta": {
    "initialized": false,
    "profile_summary": "Java 后端 / GraalVM / 远程优先，不接受纯外包刷量"
  },
  "telegram": {
    "api_id": 0,
    "api_hash": "REPLACE_ME",
    "session_name": "chat_radar"
  },
  "channels": [
    {
      "username": "@example_jobs_channel",
      "enabled": false,
      "note": "替换为你订阅的招聘频道"
    }
  ],
  "ingest": {
    "bootstrap_limit": 50,
    "request_delay_seconds": 1.0
  },
  "filter": {
    "include_keywords": [
      "Java",
      "Spring",
      "后端",
      "Backend",
      "GraalVM",
      "Native Image",
      "远程",
      "Remote",
      "JVM",
      "架构师"
    ],
    "exclude_keywords": [
      "日结",
      "刷单",
      "代理招聘",
      "纯实习",
      "无经验可"
    ],
    "include_patterns": []
  },
  "report": {
    "summary_max_chars": 300,
    "timezone": "Asia/Shanghai"
  },
  "wechat": {
    "enabled": true,
    "inbox_dir": "data/wechat_inbox",
    "export_dir": "data/wechat_exports",
    "inbox_state_file": "data/wechat_inbox_processed.json",
    "export_state_file": "data/wechat_export_processed.json",
    "default_chat": "招聘群",
    "mac_data_dir": "",
    "keys_file": "data/wechat_keys.json",
    "decrypted_cache_dir": "data/wechat_decrypted",
    "watch_chats": [],
    "sync_scope": "groups",
    "summary_scope": "all",
    "summary_output_dir": "reports/wechat_contacts",
    "summary_body_max_chars": 500,
    "summary_text_only": true,
    "self_display_name": "我",
    "note": "MVP：导出 TXT + inbox；macOS 可用 wechat locate/sync/summary 读本地库"
  },
  "log": {
    "level": "INFO",
    "redact_bodies": false
  }
}
